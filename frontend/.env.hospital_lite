# SAFE-Triage Hospital Lite — frontend env preset
#
# Usage (dev):
#   cp frontend/.env.hospital_lite frontend/.env.local
#   npm --prefix frontend run dev
#
# Hospital Lite is fully offline-capable: deterministic engine runs in the
# browser, queue + audit persist in localStorage. No Firebase, no backend
# warmup, no AI required.

VITE_APP_MODE=hospital_lite

# Optional — backend is not required for the demo. Set this only if you also
# run `SAFE_TRIAGE_MODE=hospital_lite python -m uvicorn main:app` on the same
# machine and want to forward triage to it (Phase 2).
VITE_API_URL=http://localhost:8000
