# SAFE-Triage Hospital Lite — backend env preset
#
# Usage:
#   export $(grep -v '^#' backend/.env.hospital_lite | xargs)
#   uvicorn backend.main:app --reload
#
# In hospital_lite mode the backend skips:
#   • MedGemma hourly QA job, FCM warmup, BigQuery exporters
#   • UMLS/RAG warmup, AI service preload
#   • Push alerts
# Deterministic /triage and /confirm-triage continue to work.

SAFE_TRIAGE_MODE=hospital_lite

# Supervisor PIN for triage downgrades. Change before any pilot.
SUPERVISOR_PIN=0000
