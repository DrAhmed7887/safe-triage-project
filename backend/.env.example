# Core project
PROJECT_ID=safe-triage-ai
VERTEX_REGION=us-central1

# Dr7.ai API Key (for MedGemma)
# Get from: https://dr7.ai/dashboard
DR7_API_KEY=your_dr7_api_key_here

# Optional: override endpoint/model if your Dr7 plan uses different routes
DR7_API_URL=https://dr7.ai/api/v1/medical/chat/completions
DR7_MODEL=medgemma-4b-it

# Optional retry/timing controls
MEDGEMMA_MAX_RETRIES=3
MEDGEMMA_RETRY_DELAY=5
MEDGEMMA_TIMEOUT_SECONDS=120

# Optional fallback (true/false): use Vertex Gemini if Dr7 is down
MEDGEMMA_GEMINI_FALLBACK=true
