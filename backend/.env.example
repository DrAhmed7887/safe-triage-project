# Core project
PROJECT_ID=safe-triage-ai
VERTEX_REGION=us-central1

# --- Gemma 4 27B-IT (primary extraction model) ---
# Deploy first: python deploy_gemma4_vertex.py
# Then paste the endpoint ID from deploy output:
GEMMA4_ENDPOINT_ID=
# Hugging Face token (needed for gated Gemma models during deploy)
HF_TOKEN=hf_your_token_here

# --- MedGemma 4B-IT (async QA batch review) ---
# Deploy: python deploy_medgemma_vertex.py
# Then paste the endpoint ID from deploy output:
MEDGEMMA_ENDPOINT_ID=

# Optional retry/timing controls
MEDGEMMA_MAX_RETRIES=3
MEDGEMMA_RETRY_DELAY=5
MEDGEMMA_TIMEOUT_SECONDS=120

# Fallback: use Gemini 2.5-flash if Gemma 4 / MedGemma endpoint is down
MEDGEMMA_GEMINI_FALLBACK=true

# Email notifications (SendGrid) — required for admin/supervisor alerts
SENDGRID_API_KEY=your_sendgrid_api_key_here
ALERT_EMAIL_TO=er-admin@your-hospital.example
ALERT_EMAIL_FROM=safe-triage@your-hospital.example
ALERT_EMAIL_RECIPIENTS=er-admin@your-hospital.example,supervisor@your-hospital.example

# Supervisor PIN for ESI downgrade authorization — MUST be changed from default
SUPERVISOR_PIN=CHANGE_THIS_BEFORE_DEPLOY

# Confirmation timeout (seconds) before auto-escalation
CONFIRMATION_TIMEOUT_SECONDS=300
